{
  "name": "supertonic3-voice-clone batch server",
  "imageName": "ghcr.io/OWNER/REPO:latest",
  "containerDiskInGb": 30,
  "volumeInGb": 20,
  "volumeMountPath": "/data",
  "ports": "8000/http",
  "isServerless": false,
  "readme": "Batch voice-style training + TTS over HTTP. Open the pod's 8000/http proxy URL and hit /docs for the interactive API. Set API_KEY before exposing the pod.",
  "env": [
    { "key": "API_KEY", "value": "CHANGE-ME" },
    { "key": "DATA_DIR", "value": "/data" },
    { "key": "MODEL_DIR", "value": "/opt/supertonic3" },
    { "key": "GENERATE_CONCURRENCY", "value": "4" },
    { "key": "TRAIN_CONCURRENCY", "value": "1" },
    { "key": "ORT_PROVIDER", "value": "auto" },
    { "key": "PRELOAD_ENGINE", "value": "true" },
    { "key": "LOG_LEVEL", "value": "info" }
  ],
  "recommendedGpuTypes": [
    "NVIDIA GeForce RTX 3090",
    "NVIDIA GeForce RTX 4090",
    "NVIDIA GeForce RTX 5090",
    "NVIDIA L40S",
    "NVIDIA A100 80GB PCIe"
  ]
}
