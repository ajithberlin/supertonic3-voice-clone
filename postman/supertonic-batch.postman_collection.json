    {
      "name": "Jobs",
      "description": "Submit work, watch it, fetch the artifact.",
      "item": [
        {
          "name": "Submit generate job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs",
                "generate"
              ]
            },
            "description": "Queue one synthesis. Returns 202 immediately with a job id \u2014 nothing blocks on the GPU.\n\n`style` accepts a built-in name (`F4`), a trained style id, or a path inside the server's data directory. Long text is chunked automatically and `progress` tracks the chunks.\n\nAdd `webhook_url` to be POSTed the job summary when it finishes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The batch server is running. This line was synthesized from a queued job.\",\n  \"style\": \"{{styleId}}\",\n  \"lang\": \"en\",\n  \"total_step\": 6,\n  \"speed\": 1.05,\n  \"silence_duration\": 0.3,\n  \"output_format\": \"wav\",\n  \"name\": \"demo-line\",\n  \"priority\": 0,\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));",
                  "const job = pm.response.json().job;",
                  "pm.environment.set('jobId', job.id);",
                  "console.log('jobId =', job.id, '| status =', job.status);",
                  "pm.test('job was queued', () => pm.expect(job.status).to.equal('queued'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit training job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/train",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs",
                "train"
              ]
            },
            "description": "Train a voice style from an uploaded recording. Runs 6-30 minutes on a 3090/4090 depending on `num_steps` and how quickly the loss converges.\n\n`reference_style`: `auto` scores every built-in style and seeds from the closest, `none` starts from random, or pass a style id to seed from it.\n\nOn success the style is published under `result.style_id` and is immediately usable as the `style` field of a generate job.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"my-voice\",\n  \"voice\": \"{{voiceId}}\",\n  \"gender\": \"F\",\n  \"reference_style\": \"auto\",\n  \"num_steps\": 3000,\n  \"learning_rate\": 0.0002,\n  \"seed\": 49,\n  \"speed\": 1.05,\n  \"vocoder_steps\": 6,\n  \"save_steps\": 500,\n  \"early_stop_loss_threshold\": 0.015,\n  \"priority\": 0,\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));",
                  "const job = pm.response.json().job;",
                  "pm.environment.set('jobId', job.id);",
                  "console.log('jobId =', job.id, '| status =', job.status);",
                  "pm.test('job was queued', () => pm.expect(job.status).to.equal('queued'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobId}}?include_log=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs",
                "{{jobId}}"
              ],
              "query": [
                {
                  "key": "include_log",
                  "value": "true"
                }
              ]
            },
            "description": "Status, progress, timings, result and the tail of the job log.\n\n`status` is one of `queued`, `running`, `succeeded`, `failed`, `canceled`. Poll this until it reaches a terminal state."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));",
                  "const b = pm.response.json();",
                  "console.log(`${b.id}: ${b.status} ${Math.round((b.progress || 0) * 100)}%`,",
                  "            b.progress_message || '');",
                  "if (b.status === 'failed') console.error('error:', b.error);",
                  "if (b.status === 'succeeded') console.log('result:', JSON.stringify(b.result));",
                  "pm.test('job is not failed', () => pm.expect(b.status).to.not.equal('failed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "running",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "generate",
                  "disabled": true
                },
                {
                  "key": "batch_id",
                  "value": "{{batchId}}",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Newest first. `status` may be repeated to match several at once (`?status=queued&status=running` is the live queue)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));",
                  "const b = pm.response.json();",
                  "console.log(`${b.jobs.length} of ${b.total} jobs`);",
                  "b.jobs.forEach(j => console.log(` ${j.id} ${j.type} ${j.status}`));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobId}}/logs?lines=200",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs",
                "{{jobId}}",
                "logs"
              ],
              "query": [
                {
                  "key": "lines",
                  "value": "200"
                }
              ]
            },
            "description": "Plain-text worker log. For training jobs this is the full `train_style.py` output, including per-step loss."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobId}}/result",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs",
                "{{jobId}}",
                "result"
              ]
            },
            "description": "The artifact: a WAV for generate jobs, the style JSON for training jobs. 409 while the job is still running, 410 if the file was cleaned up.\n\nUse **Send and Download** in Postman to save it."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));",
