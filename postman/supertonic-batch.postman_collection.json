            },
            "description": "Removes the job record along with its outputs and log. Cancel it first if it is still queued or running."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Batches",
      "description": "Submit many jobs at once and track them as a unit.",
      "item": [
        {
          "name": "Submit batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batches"
              ]
            },
            "description": "Queue up to `MAX_BATCH_ITEMS` (default 512) jobs in one call. Generate items fan out across the synthesis workers; train items go to the training pool. `priority` runs an item ahead of the rest.\n\nValidation is all-or-nothing: if any item names a style that does not exist, the whole batch is rejected and nothing is queued.\n\nMix job types freely \u2014 an item is `{\"type\": \"train\", \"train\": {...}}` for training.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metadata\": {\n    \"run\": \"chapter-1\"\n  },\n  \"items\": [\n    {\n      \"type\": \"generate\",\n      \"priority\": 10,\n      \"generate\": {\n        \"text\": \"First line of the batch.\",\n        \"style\": \"{{styleId}}\",\n        \"lang\": \"en\",\n        \"name\": \"line-01\"\n      }\n    },\n    {\n      \"type\": \"generate\",\n      \"generate\": {\n        \"text\": \"Second line, synthesized in parallel with the first.\",\n        \"style\": \"{{styleId}}\",\n        \"lang\": \"en\",\n        \"name\": \"line-02\"\n      }\n    },\n    {\n      \"type\": \"generate\",\n      \"generate\": {\n        \"text\": \"Third line. Add as many as you need.\",\n        \"style\": \"{{styleId}}\",\n        \"lang\": \"en\",\n        \"name\": \"line-03\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));",
                  "const b = pm.response.json();",
                  "pm.environment.set('batchId', b.batch_id);",
                  "if (b.jobs.length) pm.environment.set('jobId', b.jobs[0].id);",
                  "console.log('batchId =', b.batch_id, '| accepted', b.accepted, 'jobs');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get batch status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
